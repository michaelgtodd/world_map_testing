{
    "map": {
        "name": "Flight Planner Globe",
        "layers": [
            {
                "name": "MapZen Terrarium Elevation",
                "type": "TMSElevation",
                "uri": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png",
                "encoding": "terrarium",
                "maxLevel": 15,
                "profile": "spherical-mercator",
                "attribution": {
                    "text": "Elevation by MapZen/AWS"
                }
            },
            {
                "name": "ArcGIS World Imagery",
                "type": "TMSImage",
                "uri": "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                "format": "image/jpeg",
                "profile": "spherical-mercator",
                "invertY": false,
                "attribution": {
                    "text": "Imagery by Esri (noncommercial use)",
                    "href": "https://services.arcgisonline.com"
                }
            }
        ]
    },
    "terrain": {
        "lighting": true,
        "skirtRatio": 0.025,
        "concurrency": 8
    }
}
